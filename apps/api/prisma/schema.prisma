// CreditFlow database schema (Part A).
// Conceptual model: docs/domain-model.md. Enum values mirror packages/shared/src/enums.ts.
//
// Conventions
// - Tables and columns are snake_case in PostgreSQL (@@map / @map); camelCase in TypeScript.
// - Money: NUMERIC(14,2). Never float.
// - No hard deletes from the application. History tables are append-only.
// - CHECK constraints and the audit append-only trigger live in the migration SQL
//   (Prisma does not model them).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  ADMIN
  ANALYST
  OPERATOR
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PENDING_INFORMATION
  APPROVED
  REJECTED
  CANCELLED
}

enum CreditProductType {
  PERSONAL_LOAN
  PAYROLL_LOAN
  VEHICLE_FINANCING
  WORKING_CAPITAL
  EQUIPMENT_FINANCING
  OTHER
}

enum DocumentType {
  IDENTIFICATION
  PROOF_OF_ADDRESS
  PROOF_OF_INCOME
  BANK_STATEMENT
  OTHER
}

enum DocumentValidationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum IssueStatus {
  OPEN
  RESOLVED
}

enum ReviewRecommendation {
  APPROVE
  REJECT
  REQUEST_INFORMATION
}

enum DecisionOutcome {
  APPROVED
  REJECTED
}

// Part B (ADR-0011). Mirrors AI_SHARED_ENUMS in @creditflow/shared.

enum AiAnalysisRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum AiAnalysisTrigger {
  AUTO_FIRST_REVIEW
  MANUAL
}

enum DocumentExtractionStatus {
  OK
  UNSUPPORTED
  UNREADABLE
  SCHEMA_INVALID
  REFUSED
  TIMEOUT
  PROVIDER_ERROR
}

// ───────────────────────── Identity & access ─────────────────────────

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// Stored lower-cased; uniqueness is therefore case-insensitive.
  email              String    @unique
  name               String
  /// Argon2id hash. Never returned by the API, never logged, never audited.
  passwordHash       String    @map("password_hash")
  role               Role
  /// Explicit grant to record final credit decisions (plan, decision 6.1).
  canDecide          Boolean   @default(false) @map("can_decide")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  active             Boolean   @default(true)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions             Session[]
  customersCreated     Customer[]                 @relation("CustomerCreatedBy")
  applicationsCreated  CreditApplication[]        @relation("ApplicationCreatedBy")
  applicationsAssigned CreditApplication[]        @relation("ApplicationAssignee")
  documentsUploaded    CreditDocument[]           @relation("DocumentUploadedBy")
  documentsValidated   CreditDocument[]           @relation("DocumentValidatedBy")
  issuesCreated        ApplicationIssue[]         @relation("IssueCreatedBy")
  issuesResolved       ApplicationIssue[]         @relation("IssueResolvedBy")
  reviews              CreditReview[]
  decisions            CreditDecision[]
  statusChanges        ApplicationStatusHistory[]
  auditEvents          AuditEvent[]
  aiAnalysesRequested  AiAnalysisRun[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque session token. The token itself is never stored.
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ───────────────────────────── Customers ─────────────────────────────

model Customer {
  id                    String         @id @default(uuid()) @db.Uuid
  type                  CustomerType
  /// Full name (individual) or legal name (company).
  name                  String
  /// Digits only: CPF (11) for INDIVIDUAL, CNPJ (14) for COMPANY.
  documentNumber        String         @unique @map("document_number") @db.VarChar(14)
  email                 String
  phone                 String
  /// Birth date (individual) or foundation date (company).
  birthOrFoundationDate DateTime       @map("birth_or_foundation_date") @db.Date
  addressStreet         String         @map("address_street")
  addressNumber         String         @map("address_number")
  addressComplement     String?        @map("address_complement")
  addressDistrict       String         @map("address_district")
  addressCity           String         @map("address_city")
  /// Brazilian state code (UF), e.g. "SP".
  addressState          String         @map("address_state") @db.Char(2)
  /// Digits only (CEP).
  addressZipCode        String         @map("address_zip_code") @db.Char(8)
  status                CustomerStatus @default(ACTIVE)
  /// Set when personal data was anonymized (plan, D31 / optional stage 14).
  anonymizedAt          DateTime?      @map("anonymized_at") @db.Timestamptz(3)
  /// Optimistic locking.
  version               Int            @default(1)
  createdById           String         @map("created_by_id") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy    User                @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  applications CreditApplication[]

  @@index([name])
  @@index([status])
  @@map("customers")
}

// ──────────────────────── Credit applications ────────────────────────

model CreditApplication {
  id                         String            @id @default(uuid()) @db.Uuid
  /// Sequential number; the display code (CF-YYYY-000123) is derived from it.
  number                     Int               @unique @default(autoincrement())
  customerId                 String            @map("customer_id") @db.Uuid
  productType                CreditProductType @map("product_type")
  requestedAmount            Decimal           @map("requested_amount") @db.Decimal(14, 2)
  termMonths                 Int               @map("term_months")
  purpose                    String
  /// Monthly income (individual) or average monthly revenue (company), as declared.
  declaredMonthlyIncome      Decimal           @map("declared_monthly_income") @db.Decimal(14, 2)
  /// Monthly expenses / financial commitments, as declared.
  declaredMonthlyCommitments Decimal?          @map("declared_monthly_commitments") @db.Decimal(14, 2)
  status                     ApplicationStatus @default(DRAFT)
  assigneeId                 String?           @map("assignee_id") @db.Uuid
  createdById                String            @map("created_by_id") @db.Uuid
  submittedAt                DateTime?         @map("submitted_at") @db.Timestamptz(3)
  decidedAt                  DateTime?         @map("decided_at") @db.Timestamptz(3)
  closedAt                   DateTime?         @map("closed_at") @db.Timestamptz(3)
  version                    Int               @default(1)
  createdAt                  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer      Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignee      User?                      @relation("ApplicationAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy     User                       @relation("ApplicationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  documents     CreditDocument[]
  issues        ApplicationIssue[]
  reviews       CreditReview[]
  decision      CreditDecision?
  statusHistory ApplicationStatusHistory[]
  aiAnalyses    AiAnalysisRun[]

  @@index([status])
  @@index([customerId])
  @@index([assigneeId])
  @@index([createdAt])
  @@map("credit_applications")
}

model CreditDocument {
  id               String                   @id @default(uuid()) @db.Uuid
  applicationId    String                   @map("application_id") @db.Uuid
  type             DocumentType
  /// Free-text label, required when type = OTHER.
  otherDescription String?                  @map("other_description")
  /// Original file name as sent by the browser. Metadata only; never used as a path.
  originalName     String                   @map("original_name")
  /// Opaque key inside the document storage (random UUID-based).
  storageKey       String                   @unique @map("storage_key")
  /// MIME type detected from the file content (magic bytes), not the browser's claim.
  mimeType         String                   @map("mime_type")
  sizeBytes        Int                      @map("size_bytes")
  sha256           String                   @db.Char(64)
  uploadedById     String                   @map("uploaded_by_id") @db.Uuid
  uploadedAt       DateTime                 @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  validationStatus DocumentValidationStatus @default(PENDING) @map("validation_status")
  validationNotes  String?                  @map("validation_notes")
  validatedById    String?                  @map("validated_by_id") @db.Uuid
  validatedAt      DateTime?                @map("validated_at") @db.Timestamptz(3)
  /// Logical removal (allowed only while the application is editable).
  deletedAt        DateTime?                @map("deleted_at") @db.Timestamptz(3)

  application   CreditApplication      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  uploadedBy    User                   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  validatedBy   User?                  @relation("DocumentValidatedBy", fields: [validatedById], references: [id], onDelete: Restrict)
  aiExtractions AiDocumentExtraction[]

  @@index([applicationId])
  @@map("credit_documents")
}

/// Pendência: information the analyst needs before the application can proceed.
model ApplicationIssue {
  id             String      @id @default(uuid()) @db.Uuid
  applicationId  String      @map("application_id") @db.Uuid
  description    String
  status         IssueStatus @default(OPEN)
  createdById    String      @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedById   String?     @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?   @map("resolved_at") @db.Timestamptz(3)
  resolutionNote String?     @map("resolution_note")

  application CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  createdBy   User              @relation("IssueCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedBy  User?             @relation("IssueResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([applicationId, status])
  @@map("application_issues")
}

/// Parecer. Append-only: editing a review creates a new row; the latest is current.
model CreditReview {
  id             String               @id @default(uuid()) @db.Uuid
  applicationId  String               @map("application_id") @db.Uuid
  authorId       String               @map("author_id") @db.Uuid
  recommendation ReviewRecommendation
  analysisNotes  String               @map("analysis_notes")
  justification  String
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  application CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  author      User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  decisions   CreditDecision[]

  @@index([applicationId, createdAt])
  @@map("credit_reviews")
}

/// Final human decision. At most one per application.
model CreditDecision {
  id            String          @id @default(uuid()) @db.Uuid
  applicationId String          @unique @map("application_id") @db.Uuid
  outcome       DecisionOutcome
  justification String
  decidedById   String          @map("decided_by_id") @db.Uuid
  decidedAt     DateTime        @default(now()) @map("decided_at") @db.Timestamptz(3)
  /// Review that was current when the decision was recorded.
  reviewId      String          @map("review_id") @db.Uuid

  application CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  decidedBy   User              @relation(fields: [decidedById], references: [id], onDelete: Restrict)
  review      CreditReview      @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  @@map("credit_decisions")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  /// Null for the creation event.
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  actorId       String             @map("actor_id") @db.Uuid
  reason        String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  application CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  actor       User              @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@map("application_status_history")
}

// ──────────────────────── AI-assisted analysis (Part B) ────────────────────────

/// One AI analysis of an application (ADR-0011). Support material for the
/// analyst only: nothing here changes application data or decides anything.
model AiAnalysisRun {
  id                      String              @id @default(uuid()) @db.Uuid
  applicationId           String              @map("application_id") @db.Uuid
  trigger                 AiAnalysisTrigger
  /// Analyst who clicked "Reprocessar", or the actor of the transition that triggered it.
  requestedById           String?             @map("requested_by_id") @db.Uuid
  status                  AiAnalysisRunStatus @default(QUEUED)
  /// sha256 over the sorted document hashes, model and versions (not the application
  /// version: it changes on every transition, and the comparison with declared data
  /// is recomputed on read).
  inputFingerprint        String              @map("input_fingerprint") @db.Char(64)
  /// Application version when requested (information only).
  applicationVersion      Int                 @map("application_version")
  model                   String
  pipelineVersion         String              @map("pipeline_version")
  extractionSchemaVersion String              @map("extraction_schema_version")
  /// Prompt version of the provider adapter; "none" for the recorded extractor.
  promptVersion           String              @map("prompt_version")
  errorCode               String?             @map("error_code")
  inputTokens             Int                 @default(0) @map("input_tokens")
  outputTokens            Int                 @default(0) @map("output_tokens")
  /// Estimated provider cost (stage B3).
  costUsd                 Decimal?            @map("cost_usd") @db.Decimal(12, 6)
  latencyMs               Int?                @map("latency_ms")
  /// Worker lease; a RUNNING run whose lease expired was interrupted.
  leaseExpiresAt          DateTime?           @map("lease_expires_at") @db.Timestamptz(3)
  queuedAt                DateTime            @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt               DateTime?           @map("started_at") @db.Timestamptz(3)
  finishedAt              DateTime?           @map("finished_at") @db.Timestamptz(3)
  /// Findings and template report as computed when the run finished (comparison
  /// with the declared data at that moment). Purged with the extractions.
  reportSnapshot          Json?               @map("report_snapshot")
  /// Set when extracted content was removed by the retention policy (90 days).
  purgedAt                DateTime?           @map("purged_at") @db.Timestamptz(3)

  application CreditApplication      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  requestedBy User?                  @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  documents   AiDocumentExtraction[]

  @@index([applicationId, queuedAt])
  @@index([status, queuedAt])
  @@index([finishedAt])
  @@map("ai_analysis_runs")
}

/// Result for one document of a run. Write-once (UPDATE forbidden by trigger);
/// rows are deleted only by the retention purge.
model AiDocumentExtraction {
  id                  String                   @id @default(uuid()) @db.Uuid
  runId               String                   @map("run_id") @db.Uuid
  documentId          String                   @map("document_id") @db.Uuid
  /// Hash of the exact bytes analysed.
  documentSha256      String                   @map("document_sha256") @db.Char(64)
  declaredType        DocumentType             @map("declared_type")
  status              DocumentExtractionStatus
  detectedType        String?                  @map("detected_type")
  typeMatchesDeclared Boolean?                 @map("type_matches_declared")
  hasTextLayer        Boolean                  @map("has_text_layer")
  injectionAlert      Boolean                  @map("injection_alert")
  /// Ids of the deterministic patterns matched (never the matched text).
  injectionPatterns   String[]                 @map("injection_patterns")
  injectionModelFlag  Boolean?                 @map("injection_model_flag")
  /// FieldAssessment[] (values, quotes, evidence). Contains extracted data: purged after retention.
  fields              Json
  schemaErrors        Json                     @map("schema_errors")
  inputTokens         Int                      @default(0) @map("input_tokens")
  outputTokens        Int                      @default(0) @map("output_tokens")
  latencyMs           Int                      @default(0) @map("latency_ms")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  run      AiAnalysisRun  @relation(fields: [runId], references: [id], onDelete: Restrict)
  document CreditDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([runId, documentId])
  @@index([documentId])
  @@map("ai_document_extractions")
}

// ─────────────────────────────── Audit ───────────────────────────────

/// Append-only (enforced by a database trigger). Never stores secrets or file contents.
model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Null for system or anonymous actions (e.g. failed login of unknown e-mail).
  actorId    String?  @map("actor_id") @db.Uuid
  /// Dotted verb, e.g. "customer.created", "application.status_changed".
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  /// Allow-listed fields only.
  before     Json?
  after      Json?
  /// requestId, ip, etc.
  metadata   Json?

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([occurredAt])
  @@index([action])
  @@map("audit_events")
}
