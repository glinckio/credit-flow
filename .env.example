# Copy to .env and fill in. Never commit .env.
# All values here are for LOCAL DEVELOPMENT ONLY.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=creditflow
# Choose any local password (required).
POSTGRES_PASSWORD=
POSTGRES_DB=creditflow
POSTGRES_TEST_DB=creditflow_test
POSTGRES_PORT=5433

# --- API ---
NODE_ENV=development
API_PORT=3000
# Replace <password> with POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://creditflow:<password>@localhost:5433/creditflow
# Used only by integration tests. Never point this at the development database.
TEST_DATABASE_URL=postgresql://creditflow:<password>@localhost:5433/creditflow_test

# --- Web (Vite dev server) ---
# Change if 5173 is taken by another project; then set WEB_ORIGIN to match.
WEB_PORT=5173

# --- Security / sessions (defaults shown) ---
# Origin of the web app; state-changing requests from other origins are rejected (CSRF).
WEB_ORIGIN=http://localhost:5173
# Sliding session lifetime, in hours.
SESSION_TTL_HOURS=8
# Secure cookie flag. Leave empty for the default (true in production, false locally over http).
COOKIE_SECURE=
# Login attempts per minute per IP + e-mail.
LOGIN_RATE_LIMIT=5
# fatal|error|warn|info|debug|trace|silent (default: info; silent under NODE_ENV=test)
LOG_LEVEL=

# --- Documents ---
# Local document storage, relative to the repository root. Outside any public folder; gitignored.
STORAGE_DIR=var/storage

# --- AI-assisted analysis (Part B, ADR-0011) ---
# "disabled" (default) or "anthropic". With AI disabled nothing is queued and the
# manual analysis works as usual. SYNTHETIC DATA ONLY: never enable it with real customers.
# "recorded" replays answers from AI_RECORDINGS_DIR (<sha256>.json); used by the E2E
# suite, refused when NODE_ENV=production.
AI_PROVIDER=disabled
AI_RECORDINGS_DIR=
# Required when AI_PROVIDER=anthropic. Secret: keep it only in .env (gitignored).
ANTHROPIC_API_KEY=
# low|medium|high (default medium).
AI_EFFORT=
# Per provider call, in ms (default 60000).
AI_REQUEST_TIMEOUT_MS=
# Documents with more pages are not sent to the model (default 10).
AI_MAX_PAGES_PER_DOCUMENT=
# Once a run's estimated cost reaches this (US$), remaining documents are skipped (default 0.10).
AI_MAX_COST_USD_PER_RUN=
# Only models listed in ALLOWED_AI_MODELS (@creditflow/shared) are accepted.
AI_MODEL=claude-haiku-5-5
# Worker polling interval in ms (0 disables the worker; default 0 under NODE_ENV=test).
AI_WORKER_POLL_MS=
# A run still RUNNING after this lease is marked FAILED (interrupted) and never retried.
AI_LEASE_MS=
# Extracted content is deleted after this many days (metadata and audit are kept).
AI_RETENTION_DAYS=90
# A run over more documents fails without calling the model (cost guard).
AI_MAX_DOCUMENTS_PER_RUN=

# --- Seed (demo data, synthetic only) ---
# Password for all demo users (min. 12 chars). Leave empty to generate a random one at seed time.
SEED_DEMO_PASSWORD=
