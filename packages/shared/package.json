{
  "name": "@creditflow/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enums, permission matrix, state machine and validators shared by API and web. Pure TypeScript, no runtime dependencies.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
