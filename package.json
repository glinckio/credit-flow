{
  "name": "creditflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @creditflow/shared build && pnpm --parallel --filter @creditflow/shared --filter @creditflow/api --filter @creditflow/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @creditflow/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @creditflow/shared build && pnpm -r test",
    "db:generate": "pnpm --filter @creditflow/api db:generate",
    "db:migrate": "pnpm --filter @creditflow/api db:migrate",
    "db:seed": "pnpm --filter @creditflow/api db:seed",
    "db:reset": "pnpm --filter @creditflow/shared build && pnpm --filter @creditflow/api db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
